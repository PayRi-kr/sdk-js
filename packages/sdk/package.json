{
  "name": "@payri/sdk",
  "version": "1.0.0",
  "description": "PayRi SDK — 서버 API 클라이언트·라이선스 앱 클라이언트·웹훅 검증",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript openapi/v1.json -o src/generated/v1.ts && node scripts/generate-spec-types.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "payri",
    "payments",
    "sdk",
    "typescript",
    "javascript",
    "license",
    "webhook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PayRi-KR/sdk-js.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
